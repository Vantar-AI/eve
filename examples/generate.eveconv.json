{
  "$schema": "../spec/eve-conversation-v0.schema.json",
  "eve_conversation": "0.1.0",
  "module": {
    "id": "example.generate",
    "semantic_version": "0.1.0"
  },
  "roles": [
    {
      "id": "client",
      "placement": [
        "cpu"
      ],
      "capabilities": []
    },
    {
      "id": "server",
      "placement": [
        "accelerator"
      ],
      "capabilities": [
        "model.infer"
      ]
    }
  ],
  "types": [
    {
      "id": "prompt",
      "kind": "record",
      "fields": [
        {
          "id": "text",
          "type": "string"
        }
      ]
    },
    {
      "id": "token",
      "kind": "record",
      "fields": [
        {
          "id": "id",
          "type": "u32"
        }
      ]
    }
  ],
  "failures": [
    {
      "id": "transport.closed",
      "description": "The selected transport closed before the conversation completed.",
      "retryable": false
    },
    {
      "id": "transport.timeout",
      "description": "A local transport deadline elapsed without evidence of remote progress.",
      "retryable": true
    },
    {
      "id": "transport.reset",
      "description": "The peer or network explicitly reset the transport.",
      "retryable": false
    },
    {
      "id": "transport.unreachable",
      "description": "The remote endpoint could not be reached.",
      "retryable": true
    },
    {
      "id": "transport.uncertain",
      "description": "The endpoint cannot determine how far its peer progressed.",
      "retryable": false
    }
  ],
  "initial": "start",
  "states": [
    {
      "kind": "send",
      "id": "start",
      "from": "client",
      "to": "server",
      "message": "prompt",
      "deadline": "20ms",
      "next": "decide",
      "on_failure": {
        "transport.closed": "transport-failed",
        "transport.reset": "transport-reset",
        "transport.timeout": "transport-timeout",
        "transport.uncertain": "transport-uncertain",
        "transport.unreachable": "transport-unreachable"
      }
    },
    {
      "kind": "choice",
      "id": "decide",
      "chooser": "server",
      "branches": {
        "token": "emit-token",
        "done": "end"
      },
      "on_failure": {
        "transport.closed": "transport-failed",
        "transport.reset": "transport-reset",
        "transport.timeout": "transport-timeout",
        "transport.uncertain": "transport-uncertain",
        "transport.unreachable": "transport-unreachable"
      }
    },
    {
      "kind": "send",
      "id": "emit-token",
      "from": "server",
      "to": "client",
      "message": "token",
      "next": "client-action",
      "on_failure": {
        "transport.closed": "transport-failed",
        "transport.reset": "transport-reset",
        "transport.timeout": "transport-timeout",
        "transport.uncertain": "transport-uncertain",
        "transport.unreachable": "transport-unreachable"
      }
    },
    {
      "kind": "choice",
      "id": "client-action",
      "chooser": "client",
      "branches": {
        "continue": "decide",
        "cancel": "cancel"
      },
      "on_failure": {
        "transport.closed": "transport-failed",
        "transport.reset": "transport-reset",
        "transport.timeout": "transport-timeout",
        "transport.uncertain": "transport-uncertain",
        "transport.unreachable": "transport-unreachable"
      }
    },
    {
      "kind": "cancel",
      "id": "cancel",
      "from": "client",
      "to": "server",
      "scope": "generation",
      "next": "end",
      "on_failure": {
        "transport.closed": "transport-failed",
        "transport.reset": "transport-reset",
        "transport.timeout": "transport-timeout",
        "transport.uncertain": "transport-uncertain",
        "transport.unreachable": "transport-unreachable"
      }
    },
    {
      "kind": "end",
      "id": "end"
    },
    {
      "kind": "fail",
      "id": "transport-failed",
      "failure": "transport.closed"
    },
    {
      "kind": "fail",
      "id": "transport-timeout",
      "failure": "transport.timeout"
    },
    {
      "kind": "fail",
      "id": "transport-reset",
      "failure": "transport.reset"
    },
    {
      "kind": "fail",
      "id": "transport-unreachable",
      "failure": "transport.unreachable"
    },
    {
      "kind": "fail",
      "id": "transport-uncertain",
      "failure": "transport.uncertain"
    }
  ],
  "annotations": {
    "title": "Two-role token generation with cancellation",
    "status": "executable experiment"
  }
}
