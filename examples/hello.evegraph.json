    "policies": [
      {
        "id": "no-authority-expansion",
        "scope": [
          "sender",
          "receiver"
        ],
        "predicate": "candidate.capabilities <= parent.capabilities",
        "authority": "promote"
      }
    ]
  },
  "entrypoints": [
    {
      "cell": "sender",
      "event": "start",
      "deployable": false
    }
  ],
  "annotations": {
    "title": "Hello flow with typed implementation holes",
    "note": "This graph is intentionally incomplete and therefore not deployable."
  }
