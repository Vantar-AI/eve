{
  "$schema": "../spec/eve-graph-v0.schema.json",
  "eve_graph": "0.1.0",
  "module": {
    "id": "example.hello",
    "semantic_version": "0.0.0"
  },
  "definitions": {
    "types": [
      {
        "id": "u128",
        "kind": "scalar",
        "scalar": "u128"
      },
      {
        "id": "bytes",
        "kind": "scalar",
        "scalar": "bytes"
      },
      {
        "id": "message",
        "kind": "record",
        "fields": [
          {
            "id": "id",
            "type": "u128"
          },
          {
            "id": "body",
            "type": "bytes"
          }
        ],
        "annotations": {
          "name": "Message"
        }
      }
    ],
    "capabilities": [
      {
        "id": "log",
        "resource": "eve:log",
        "permissions": [
          "append"
        ],
        "delegation": "none"
      }
