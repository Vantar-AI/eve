    "flows": [
      {
        "id": "messages",
        "message": "message",
        "from": {
          "cell": "sender",
          "port": "messages"
        },
        "to": [
          {
            "cell": "receiver",
            "port": "messages"
          }
        ],
        "contract": {
          "delivery": "at_most_once",
          "ordering": {
            "scope": "key",
            "key": "$.id"
          },
          "capacity": 256,
          "deadline": "5ms",
          "durability": "memory",
          "on_unavailable": "fail",
          "transport": {
            "prefer": [
              "shared-memory",
              "quic"
            ]
          }
        }
      }
