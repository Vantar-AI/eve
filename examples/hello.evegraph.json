    "cells": [
      {
        "id": "sender",
        "ports": [
          {
            "id": "messages",
            "direction": "out",
            "message": "message",
            "failures": [
              "timeout",
              "unavailable"
            ]
          }
        ],
        "implementation": {
          "kind": "hole",
          "hole": {
            "id": "send-once",
            "expected": "handler(start) -> emit(message)",
            "bindings": [],
            "effect_ceiling": [
              "random",
              "send"
            ],
            "failure_ceiling": [
              "timeout",
              "unavailable"
            ],
            "capability_ceiling": [],
            "obligations": [
              "Emit exactly one Message when the start event is received."
            ]
          }
        },
        "effects": [
          "random",
          "send"
        ],
        "failures": [
          "timeout",
          "unavailable"
        ],
        "requires": [],
        "budget": {
          "memory": "16MiB"
        },
        "placement": {
          "requires": [
            "cpu"
          ],
          "replicas": {
            "min": 1,
            "max": 1
          }
        },
        "concurrency": "serial",
        "evolution": {
          "mode": "implementation",
          "preserve": [
            "ports",
            "effects",
            "failures",
            "capabilities"
          ]
        },
        "annotations": {
          "name": "Sender"
        }
      },
      {
        "id": "receiver",
        "ports": [
          {
            "id": "messages",
            "direction": "in",
            "message": "message",
            "failures": []
          }
        ],
        "implementation": {
          "kind": "hole",
          "hole": {
            "id": "log-message",
            "expected": "handler(message) -> unit",
            "bindings": [
              {
                "id": "message",
                "type": "message"
              }
            ],
            "effect_ceiling": [
              "log"
            ],
            "failure_ceiling": [],
            "capability_ceiling": [
              "log"
            ],
            "obligations": [
              "Append the message identity to the provided log capability."
            ]
          }
        },
        "effects": [
          "log"
        ],
        "failures": [],
        "requires": [
          "log"
        ],
        "budget": {
          "memory": "16MiB"
        },
        "placement": {
          "requires": [
            "cpu"
          ],
          "replicas": {
            "min": 1,
            "max": 1
          }
        },
        "concurrency": "serial",
        "evolution": {
          "mode": "implementation",
          "preserve": [
            "ports",
            "effects",
            "failures",
            "capabilities"
          ]
        },
        "annotations": {
          "name": "Receiver"
        }
      }
